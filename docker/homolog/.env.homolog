APP_NAME="Receitas Homolog"
APP_ENV=homolog
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db-homolog
DB_PORT=5432
DB_DATABASE=receitas_homolog
DB_USERNAME=receitas
DB_PASSWORD=receitas_homolog

SESSION_DRIVER=database
CACHE_STORE=file
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=homolog@example.com
MAIL_FROM_NAME="${APP_NAME}"
